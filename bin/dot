#!/usr/bin/env bash
#
# Utilitário de manutenção dos dotfiles.
# Espera que a variável DOTFILES_DIR aponte para o repositório (exportada no .zshrc, se necessário).

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1

sub_help () {
  echo "Uso: $BIN_NAME <comando>"
  echo
  echo "Comandos:"
  echo "   clean    Limpar caches (brew, gem, pip)"
  echo "   edit     Abrir o repositório de dotfiles no editor (\$VISUAL ou \$EDITOR)"
  echo "   macos    Reaplicar defaults do macOS (macosdefaults.sh)"
  echo "   update   Atualizar pacotes Homebrew (formulae e casks)"
  echo "   help     Esta mensagem"
}

sub_clean () {
  brew cleanup
  command -v gem >/dev/null && gem cleanup
  command -v pip >/dev/null && pip cache purge
}

sub_edit () {
  DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
  "${VISUAL:-${EDITOR:-code}}" "$DOTFILES_DIR"
}

sub_macos () {
  DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
  bash "$DOTFILES_DIR/macosdefaults.sh"
}

sub_update () {
  brew update
  brew upgrade
  brew upgrade --cask
  brew cleanup
}

case $COMMAND_NAME in
  "" | "-h" | "--help")
    sub_help
    ;;
  *)
    shift
    if declare -f "sub_${COMMAND_NAME}" >/dev/null; then
      "sub_${COMMAND_NAME}" "$@"
    else
      echo "'$COMMAND_NAME' não é um comando conhecido." >&2
      sub_help
      exit 1
    fi
    ;;
esac
