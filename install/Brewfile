# Taps de terceiros (homebrew/bundle e homebrew/services já vêm embutidos no brew)
tap "asmvik/formulae"            # yabai
tap "infisical/get-cli"          # infisical
tap "oven-sh/bun"                # bun
tap "hashicorp/tap"              # terraform

# Ferramentas essenciais de desenvolvimento
brew "git"                       # Controle de versão
brew "git-extras"                # Comandos extras do git
brew "gh"                        # CLI do GitHub
brew "stow"                      # Gerenciamento de dotfiles (symlinks)
brew "tree"                      # Visualização de diretórios em árvore
brew "grep"                      # GNU grep (versão recente, sobre o grep do sistema)
brew "wget"                      # Download de arquivos

# Utilitários CLI modernos
brew "fd"                        # find mais rápido — aliased como `find`
brew "ripgrep"                   # grep muito mais rápido — aliased como `grep`
brew "jq"                        # Processador JSON
brew "biome"                     # Linter/formatter JS/TS rápido

# Ecossistema Node.js
brew "node"                      # Node.js (versão atual)
brew "nvm"                       # Gerenciador de versão do Node
brew "pnpm"                      # Gerenciador de pacotes (principal)
brew "oven-sh/bun/bun"           # Runtime/gerenciador JS alternativo

# Python
brew "uv"                        # Gerenciador de pacotes/ambientes Python

# PHP
brew "php"                       # PHP (atual) — PATH do php@8.5 no .zshrc
brew "composer"                  # Gerenciador de pacotes PHP

# Cloud / Secrets / Mídia
brew "awscli"                    # CLI da AWS
brew "hashicorp/tap/terraform"   # Infraestrutura como código
brew "neonctl"                   # CLI do Neon (Postgres)
brew "infisical/get-cli/infisical" # Gerenciamento de secrets (uso lazy — ver infisical-login no .zshrc)
brew "ffmpeg"                    # Processamento de vídeo/áudio

# Janela / produtividade
brew "asmvik/formulae/yabai"     # Window manager — usado pelos scripts do Raycast

# Shell — syntax highlighting é carregado direto no .zshrc.
# Os plugins zsh-autosuggestions/zsh-completions ficam por conta do oh-my-zsh
# (clonados pelo `make zsh-plugins`), não pelo brew.
brew "zsh-syntax-highlighting"

