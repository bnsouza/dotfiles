# Repositórios essenciais
tap "homebrew/bundle"
tap "homebrew/services"

# Ferramentas essenciais de desenvolvimento
brew "git"                       # Controle de versão
brew "git-extras"                # Comandos extras do git
brew "gh"                        # CLI do GitHub
brew "stow"                      # Gerenciamento de dotfiles (symlinks)
brew "tree"                      # Visualização de diretórios em árvore
brew "grep"                      # GNU grep (versão recente, sobre o grep do sistema)
brew "wget"                      # Download de arquivos

# Utilitários CLI modernos
brew "fd"                        # find mais rápido — aliased como `find`
brew "ripgrep"                   # grep muito mais rápido — aliased como `grep`
brew "jq"                        # Processador JSON
brew "biome"                     # Linter/formatter JS/TS rápido

# Ecossistema Node.js
brew "node"                      # Node.js (versão atual)
brew "nvm"                       # Gerenciador de versão do Node
brew "pnpm"                      # Gerenciador de pacotes (principal)
brew "bun"                       # Runtime/gerenciador JS alternativo

# Cloud / Secrets / Mídia
brew "awscli"                    # CLI da AWS
brew "infisical"                 # Gerenciamento de secrets (uso lazy — ver infisical-login no .zshrc)
brew "ffmpeg"                    # Processamento de vídeo/áudio

# Janela / produtividade
brew "yabai"                     # Window manager para macOS

# Shell — syntax highlighting é carregado direto no .zshrc.
# Os plugins zsh-autosuggestions/zsh-completions ficam por conta do oh-my-zsh
# (clonados pelo `make zsh-plugins`), não pelo brew.
brew "zsh-syntax-highlighting"

# Extensões VS Code
vscode "anthropic.claude-code"
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "openai.chatgpt"
vscode "dracula-theme.theme-dracula"
vscode "biomejs.biome"
vscode "bradlc.vscode-tailwindcss"
vscode "christian-kohler.npm-intellisense"
vscode "bierner.markdown-mermaid"
vscode "yzhang.markdown-all-in-one"
vscode "formulahendry.auto-rename-tag"
vscode "pkief.material-icon-theme"
vscode "ms-vscode.sublime-keybindings"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode-remote.remote-ssh"
vscode "ms-vscode-remote.remote-ssh-edit"
vscode "ms-azuretools.vscode-docker"
vscode "docker.docker"
vscode "esbenp.prettier-vscode"
vscode "github.vscode-github-actions"
vscode "github.vscode-pull-request-github"
